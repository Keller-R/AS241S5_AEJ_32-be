# RapidAPI Keys - Get these from https://rapidapi.com
GOOGLE_MAPS_RAPIDAPI_KEY=your_google_maps_rapidapi_key_here
IP_GEO_RAPIDAPI_KEY=your_ip_geo_rapidapi_key_here

# Database Configuration (optional - defaults are in application.yml)
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# MongoDB URI (if using MongoDB)
MONGODB_URI=mongodb://localhost:27017/consumo_apis
